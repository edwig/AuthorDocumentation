IDD_HR_PROPERTIES DIALOGEX 0, 0, 272, 155
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Horizontal line"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Size:",IDC_STATIC,7,9,25,8
    EDITTEXT        IDC_HRSIZE,51,7,54,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_SPIN1,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,94,7,11,14
    LTEXT           "In pixels",IDC_STATIC,114,10,57,8
    LTEXT           "&Width:",IDC_STATIC,7,28,26,8
    EDITTEXT        IDC_HRWIDTH,51,27,54,12,ES_AUTOHSCROLL
    CONTROL         "",IDC_SPIN2,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,93,25,12,14
