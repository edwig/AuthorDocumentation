    LTEXT           "A&lignment:",IDC_STATIC,7,47,38,8
    COMBOBOX        IDC_HRALIGN,51,45,54,66,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Line color:",IDC_STATIC,7,67,40,8
    PUSHBUTTON      "Line color",IDC_HRCOLOR,51,64,54,14
    CONTROL         "&No shade",IDC_HRNOSHADE,"Button",BS_AUTORADIOBUTTON,51,84,47,10
    CONTROL         "S&hade",IDC_HRSHADE,"Button",BS_AUTORADIOBUTTON,51,97,46,10
    PUSHBUTTON      "&ID",IDC_HR_ID,51,117,50,14
