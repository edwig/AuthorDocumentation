/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New File\tCtrl+N",           ID_FILE_NEW
        MENUITEM "N&ew Project",                ID_FILE_NEWPROJECT
        MENUITEM "&Open File...",               ID_FILE_OPEN
        MENUITEM "Open &URL...",                ID_FILE_OPENURL
        MENUITEM "Ope&n Project...",            ID_FILE_OPENPROJECT
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM "&Close Project...",           ID_CLOSEPROJECT
        MENUITEM SEPARATOR
        MENUITEM "Startup &Dialog...",          ID_STARTUP
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view....",          ID_FILE_PRINTPREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM "P&age setup...",              ID_FILE_PAGESETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM "&Redo\tCtrl+Y",               ID_EDIT_REDO32873
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
        MENUITEM "&Select All",                 ID_EDIT_SELECT_ALL
        MENUITEM SEPARATOR
        MENUITEM "&Bold",                       ID_BUTTON_BOLD
        MENUITEM "&Italic",                     ID_BUTTON_ITALIC
        MENUITEM "&Underline",                  ID_EDIT_REPLACE_AA
        MENUITEM SEPARATOR
        MENUITEM "&Find\tCtrl+F",               ID_EDIT_FIND
        MENUITEM "Re&place\tCtrl+H",            ID_EDIT_REPLACE
        MENUITEM SEPARATOR
        MENUITEM "Remove &Hyperlink...",        ID_EDIT_REMOVEHYPERLINK
        MENUITEM "&Change Comment....",         ID_EDIT_COMMENT
        MENUITEM SEPARATOR
        MENUITEM "Check &Spelling\tF7",         ID_EDIT_CHECKSPELLING
        MENUITEM "Spelling &Options...",        ID_EDIT_SPELLINGOPTIONS
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Themes...",                  ID_VIEW_THEMES
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        POPUP "Working &panels"
        BEGIN
            MENUITEM "&Table of Contents",          ID_PANE_TOC
            MENUITEM "&Index",                      ID_PANE_KEYWORDS
            MENUITEM "Page &Links",                 ID_PANE_LINKS
            MENUITEM "&Project",                    ID_PANE_PROJECT
            MENUITEM "Document &explorer",          ID_PANE_EXPLORER
            MENUITEM "&Open documents",             ID_PANE_DOCUMENTS
            MENUITEM "&Compilation",                ID_PANE_COMPILE
        END
        POPUP "&Toolbars"
        BEGIN
            MENUITEM "Toolbar",                     59392
        END
        MENUITEM SEPARATOR
        MENUITEM "&Web\tCtrl+W",                ID_VIEW_WEB
        MENUITEM "Sou&rce\tCtrl+R",             ID_VIEW_SOURCE
        MENUITEM "&Browse mode",                ID_VIEW_BROWSE
        MENUITEM SEPARATOR
        MENUITEM "Table &borders",              ID_VIEW_TABLEBORDERS
        MENUITEM "Ta&gs\tCtrl+A",               ID_VIEW_TAGS
        POPUP "&Grid"
        BEGIN
            MENUITEM "&Show the grid",              ID_GRID_SHOWGRID
            MENUITEM "S&nap to grid",               ID_GRID_SNAPTOGRID
            MENUITEM "Grid &properties...",         ID_GRID_GRIDPROPERTIES
        END
        MENUITEM SEPARATOR
        MENUITEM "Special test",                ID_VIEW_SPECIALTEST
    END
    POPUP "Insert"
    BEGIN
        MENUITEM "&Hyperlink....",              ID_BUTTON_HYPERLINK
        MENUITEM "&Image....",                  ID_BUTTON_IMAGE
        MENUITEM "Inline &frame...",            ID_INSERT_IFRAME
        MENUITEM "Horizontal &line",            ID_INSERT_HORIZONTALLINE
        MENUITEM "&Characters && symbols...",   ID_INSERT_SYMBOL
        MENUITEM "Marquee",                     ID_MARQUEE
        MENUITEM "&Comment...",                 ID_INSERT_COMMENT
        MENUITEM "Layer...",                    ID_INSERT_LAYER
        MENUITEM "F&ile....",                   ID_INSERT_FILE
        POPUP "Form"
        BEGIN
            MENUITEM "Define form...",              ID_INSERT_FORM
            MENUITEM SEPARATOR
            MENUITEM "Field",                       ID_FORM_FIELD
            MENUITEM "Button",                      ID_FORM_BUTTON
            MENUITEM "Text area",                   ID_FORM_TEXTAREA
            MENUITEM "Selection list",              ID_FORM_SELECTIONLIST
            MENUITEM "Image",                       ID_FORM_IMAGE
            MENUITEM "Label",                       ID_FORM_LABEL
            MENUITEM SEPARATOR
