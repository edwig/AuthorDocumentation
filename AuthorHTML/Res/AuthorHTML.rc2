//
// Version
//
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VERSION_MAJOR,VERSION_MINOR,VERSION_SP,BUILD_NUMBER
 PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_SP,BUILD_NUMBER
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "AuthorHTML of AuthorDocumentation"
            VALUE "FileVersion",      VERSION_COMPLETE
            VALUE "InternalName",     TECHNICAL_APP
            VALUE "LegalCopyright",   "Written bij: ir. W.E. Huisman.  MIT License!."
            VALUE "OriginalFilename", TECHNICAL_APP
            VALUE "ProductName",      "AuthorDocumentation"
            VALUE "ProductVersion",   VERSION_COMPLETE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


